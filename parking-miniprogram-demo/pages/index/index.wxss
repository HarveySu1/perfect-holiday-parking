/* 页面容器 */
.page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #D6E4F0;
  overflow: hidden;
}

/* 状态栏 */
.status-bar {
  width: 100%;
  flex-shrink: 0;
}

/* 导航栏 */
.nav-bar {
  width: 100%;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 100;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.nav-left,
.nav-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-icon {
  font-size: 44rpx;
  color: #333;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-more {
  font-size: 32rpx;
  color: #333;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.nav-eye {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #333;
  font-weight: 700;
}

/* 地图区 */
.map-container {
  flex: 1;
  position: relative;
  width: 100%;
  min-height: 400rpx;
  overflow: hidden;
  background: #D6E4F0;
}

.map-area {
  width: 100%;
  height: 100%;
}

.map-view {
  position: relative;
  background: transparent;
}

.map-image {
  display: block;
}

.mode-3d {
  transform: scale(1.05) perspective(800rpx) rotateX(35deg);
  transform-origin: center center;
}

/* 路线层 */
.route-layer {
  position: absolute;
  left: 80rpx;
  top: 120rpx;
  pointer-events: none;
}

.route-arrow {
  opacity: 0.95;
}

/* 标记点 */
.spot-marker {
  position: absolute;
  transform: translate(-50%, -100%);
  z-index: 10;
}

.marker-elevator {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.elevator-icon {
  width: 48rpx;
  height: 48rpx;
  background: #F5A623;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.elevator-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,0.45);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  white-space: nowrap;
}

.marker-pin {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.pin-body {
  width: 72rpx;
  height: 56rpx;
  background: #4A90E2;
  clip-path: polygon(50% 100%, 0 0, 100% 0);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 8rpx;
  box-sizing: border-box;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

.pin-text {
  font-size: 18rpx;
  color: #fff;
  font-weight: 600;
  white-space: nowrap;
}

.spot-marker.highlight .elevator-icon {
  background: #E8913A;
  transform: scale(1.15);
}

/* 指南针 */
.compass {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  z-index: 50;
}

.compass-bg {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  position: relative;
}

.compass-n {
  position: absolute;
  top: 4rpx;
  font-size: 18rpx;
  color: #E24B4B;
  font-weight: 700;
}

.compass-needle {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 40rpx solid #4A90E2;
  transform: rotate(-30deg);
}

/* 楼层选择器 */
.floor-selector {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 50;
  background: rgba(255,255,255,0.95);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx;
  min-width: 84rpx;
}

.floor-title {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.floor-arrow {
  font-size: 16rpx;
  color: #4A90E2;
  padding: 8rpx 16rpx;
}

.floor-item {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  margin: 6rpx 0;
  font-weight: 500;
}

.floor-item.active {
  background: #4A90E2;
  color: #fff;
  font-weight: 600;
}

/* 2D/3D 切换 */
.view-toggle {
  position: absolute;
  left: 24rpx;
  bottom: 32rpx;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.toggle-circle {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.toggle-icon {
  font-size: 34rpx;
  color: #333;
  font-weight: 700;
}

.toggle-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #333;
  background: rgba(255,255,255,0.9);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

/* 车位弹窗 */
.spot-popup {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
  z-index: 80;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.spot-title-wrap {
  display: flex;
  align-items: baseline;
}

.spot-id {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-right: 16rpx;
}

.spot-type {
  font-size: 24rpx;
  color: #999;
}

.popup-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 8rpx;
}

.popup-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.facility-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.popup-actions {
  display: flex;
  gap: 16rpx;
}

.btn-outline {
  padding: 12rpx 28rpx;
  border: 2rpx solid #4A90E2;
  border-radius: 10rpx;
  color: #4A90E2;
  font-size: 24rpx;
  font-weight: 500;
}

.btn-outline.primary {
  background: #4A90E2;
  color: #fff;
}

/* 底部面板 */
.bottom-panel {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.08);
  padding: 24rpx 32rpx 32rpx;
  box-sizing: border-box;
  z-index: 90;
  flex-shrink: 0;
}

.bottom-panel.route-panel {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.search-btn {
  width: 100%;
  height: 88rpx;
  background: #4A90E2;
  color: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

/* 路线面板 */
.route-card {
  width: 100%;
}

.route-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.route-3d {
  width: 72rpx;
  height: 72rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
  font-weight: 700;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.route-points {
  flex: 1;
}

.point-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.dot.green {
  background: #4CAF50;
}

.dot.orange {
  background: #F5A623;
}

.point-label {
  font-size: 28rpx;
  color: #666;
}

.point-value {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex: 1;
}

.edit-icon {
  font-size: 28rpx;
  color: #999;
  padding: 0 8rpx;
}

.plate-tag {
  padding: 4rpx 16rpx;
  border: 2rpx solid #4A90E2;
  border-radius: 8rpx;
  color: #4A90E2;
  font-size: 22rpx;
  font-weight: 500;
}

.route-meta {
  font-size: 24rpx;
  color: #999;
  margin-left: 84rpx;
  margin-bottom: 24rpx;
}

.route-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-cancel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  color: #666;
  font-size: 22rpx;
}

.cancel-icon {
  font-size: 44rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.action-nav {
  flex: 1;
  height: 88rpx;
  background: #4A90E2;
  color: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

/* 查询弹窗 */
.search-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.search-card {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.search-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
  text-align: center;
}

.search-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.search-actions {
  display: flex;
  gap: 20rpx;
}

.search-actions .btn-cancel,
.search-actions .btn-confirm {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.search-actions .btn-cancel {
  background: #F5F5F5;
  color: #666;
}

.search-actions .btn-confirm {
  background: #4A90E2;
  color: #fff;
}

/* Toast */
.toast {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0,0,0,0.75);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  z-index: 300;
}
