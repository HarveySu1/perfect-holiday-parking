<Slide style={{ width: '1280px', height: '720px', padding: '20px 64px', flexDirection: 'column', background: '#FFFFFF' }}>
    {/* A 标题块 */}
    <Box style={{ height: '100px', flexDirection: 'column', justifyContent: 'center', gap: '6px' }}>
        <Text style={{ fontSize: 13, fontWeight: 600, color: '#2456E6', letterSpacing: 2 }}>方案创新 · 怎么做</Text>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#16181D', lineHeight: 1.25 }}>不另起炉灶做第 4 个停车 App，只在「设为终点」前插一步</Text>
    </Box>

    {/* B 内容区 */}
    <Box style={{ height: '540px', flexDirection: 'row', gap: '24px' }}>
        {/* 左 62%：三增量 */}
        <Box style={{ width: '700px', flexDirection: 'column', gap: '12px' }}>
            <Text style={{ fontSize: 18, fontWeight: 600, color: '#16181D' }}>三个增量，全部复用主办方已有能力</Text>

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E8EF', borderRadius: '14px', padding: '14px 20px', flexDirection: 'row', alignItems: 'center', gap: '16px' }}>
                <Box style={{ width: '46px', height: '46px', borderRadius: '12px', background: '#2456E6', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>①</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: '5px' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#16181D' }}>目的地选车位</Text>
                        <Box style={{ marginLeft: 'auto', background: 'rgba(15,169,88,0.10)', border: '1px solid rgba(15,169,88,0.35)', borderRadius: '999px', padding: '3px 12px' }}>
                            <Text style={{ fontSize: 12, color: '#0FA958', fontWeight: 600 }}>复用：车位真值 · 地图 · 电梯厅标注</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 14, color: '#5C6470', lineHeight: 1.5 }}>输入「去哪」→ 综合步行距离 + 楼层 + 电梯口，推荐最近车位</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E8EF', borderRadius: '14px', padding: '14px 20px', flexDirection: 'row', alignItems: 'center', gap: '16px' }}>
                <Box style={{ width: '46px', height: '46px', borderRadius: '12px', background: '#2456E6', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>②</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: '5px' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#16181D' }}>电梯厅选梯</Text>
                        <Box style={{ marginLeft: 'auto', background: 'rgba(15,169,88,0.10)', border: '1px solid rgba(15,169,88,0.35)', borderRadius: '999px', padding: '3px 12px' }}>
                            <Text style={{ fontSize: 12, color: '#0FA958', fontWeight: 600 }}>复用：电梯厅位置数据</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 14, color: '#5C6470', lineHeight: 1.5 }}>把已标注的 1–6 号电梯厅建成多层图上的边，让算法自己选梯</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E8EF', borderRadius: '14px', padding: '14px 20px', flexDirection: 'row', alignItems: 'center', gap: '16px' }}>
                <Box style={{ width: '46px', height: '46px', borderRadius: '12px', background: '#2456E6', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>③</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: '5px' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#16181D' }}>充电桩导航</Text>
                        <Box style={{ marginLeft: 'auto', background: 'rgba(15,169,88,0.10)', border: '1px solid rgba(15,169,88,0.35)', borderRadius: '999px', padding: '3px 12px' }}>
                            <Text style={{ fontSize: 12, color: '#0FA958', fontWeight: 600 }}>复用：车位-桩绑定 · 已有导航</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 14, color: '#5C6470', lineHeight: 1.5 }}>查空闲桩并导航，桩状态三级来源 + 置信度衰减，不伪造状态</Text>
                </Box>
            </Box>

            <Box style={{ height: '48px', flexDirection: 'row', alignItems: 'center', gap: '12px', background: 'rgba(36,86,230,0.06)', borderRadius: '10px', padding: '0 18px' }}>
                <Box style={{ width: '4px', height: '22px', background: '#2456E6', borderRadius: '2px' }} />
                <Text style={{ fontSize: 17, fontWeight: 600, color: '#2456E6' }}>最好的改进，是让已有的能力真正被用起来。</Text>
            </Box>
        </Box>

        {/* 右 38%：边界（不做什么） */}
        <Box style={{ flex: 1, background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '16px', padding: '22px', flexDirection: 'column', gap: '14px' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#16181D' }}>不做什么</Text>
                <Text style={{ marginLeft: 'auto', fontSize: 12, color: '#5C6470' }}>边界即说服力</Text>
            </Box>
            <Box style={{ height: '1px', background: '#E5E8EF' }} />

            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'flex-start', gap: '10px' }}>
                <FAIcon name='times' style={{ fill: '#F5A623', width: '15px', height: '15px', marginTop: '3px' }} />
                <Box style={{ flexDirection: 'column', gap: '3px' }}>
                    <Text style={{ fontSize: 15, fontWeight: 600, color: '#16181D' }}>不重建 2D/3D 地图</Text>
                    <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.45 }}>已有，精度足够</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'flex-start', gap: '10px' }}>
                <FAIcon name='times' style={{ fill: '#F5A623', width: '15px', height: '15px', marginTop: '3px' }} />
                <Box style={{ flexDirection: 'column', gap: '3px' }}>
                    <Text style={{ fontSize: 15, fontWeight: 600, color: '#16181D' }}>不重写导航引擎</Text>
                    <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.45 }}>「设为终点 → 模拟导航」链路直接复用</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'flex-start', gap: '10px' }}>
                <FAIcon name='times' style={{ fill: '#F5A623', width: '15px', height: '15px', marginTop: '3px' }} />
                <Box style={{ flexDirection: 'column', gap: '3px' }}>
                    <Text style={{ fontSize: 15, fontWeight: 600, color: '#16181D' }}>不新增硬件</Text>
                    <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.45 }}>零传感器、零施工</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'flex-start', gap: '10px' }}>
                <FAIcon name='times' style={{ fill: '#F5A623', width: '15px', height: '15px', marginTop: '3px' }} />
                <Box style={{ flexDirection: 'column', gap: '3px' }}>
                    <Text style={{ fontSize: 15, fontWeight: 600, color: '#16181D' }}>不另做小程序</Text>
                    <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.45 }}>云函数挂载到已有小程序</Text>
                </Box>
            </Box>

            <Box style={{ background: 'rgba(15,169,88,0.10)', border: '1px solid rgba(15,169,88,0.35)', borderRadius: '999px', padding: '8px 16px', alignSelf: 'flex-start' }}>
                <Text style={{ fontSize: 13, fontWeight: 600, color: '#0FA958' }}>零硬件 · 零系统改造</Text>
            </Box>
        </Box>
    </Box>

    {/* C 页脚条 */}
    <Box style={{ height: '40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
            <FAIcon name='car' style={{ fill: '#2456E6', width: '18px', height: '18px' }} />
            <Text style={{ fontSize: 13, color: '#5C6470' }}>车记得 · 完美金鹰假日商圈 AI 大赛</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#5C6470' }}><span style={{ fontWeight: 'bold', color: '#2456E6' }}>04</span> / 12</Text>
    </Box>
</Slide>
