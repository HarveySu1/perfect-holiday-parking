<Slide style={{ width: '1280px', height: '720px', padding: '20px 64px', flexDirection: 'column', background: '#FFFFFF' }}>
    {/* A 标题块 */}
    <Box style={{ height: '100px', flexDirection: 'column', justifyContent: 'center', gap: '6px' }}>
        <Text style={{ fontSize: 13, fontWeight: 600, color: '#2456E6', letterSpacing: 2 }}>AI 实际应用 · 是装饰吗</Text>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#16181D', lineHeight: 1.25 }}>AI 用在该用的层，其余刻意不用</Text>
    </Box>

    {/* B 内容区 */}
    <Box style={{ height: '540px', flexDirection: 'column', gap: '16px' }}>
        <Box style={{ flexDirection: 'row', gap: '24px', flex: 1 }}>
            {/* 左：巨型数字锚点 */}
            <Box style={{ width: '420px', background: '#2456E6', borderRadius: '16px', padding: '28px', flexDirection: 'column', justifyContent: 'space-between', position: 'relative', overflow: 'hidden' }}>
                <Box style={{ position: 'absolute', right: '0px', bottom: '0px' }}>
                    <FAIcon name='robot' style={{ fill: 'rgba(255,255,255,0.07)', width: '150px', height: '150px' }} />
                </Box>
                <Text style={{ fontSize: 13, fontWeight: 600, color: 'rgba(255,255,255,0.65)', letterSpacing: 3 }}>AI 用点</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: '12px' }}>
                    <Text style={{ fontSize: 96, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 0.9, fontFamily: '"Inter", "Noto Sans SC", sans-serif' }}>3</Text>
                    <Box style={{ flexDirection: 'column', paddingBottom: '8px', gap: '4px' }}>
                        <Text style={{ fontSize: 26, fontWeight: 600, color: '#FFFFFF', lineHeight: 1.2 }}>层</Text>
                        <Text style={{ fontSize: 13, color: 'rgba(255,255,255,0.72)' }}>入口 · 兜底 · 输出</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'column', gap: '12px' }}>
                    <Box style={{ width: '32px', height: '2px', background: 'rgba(255,255,255,0.35)' }} />
                    <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.90)', lineHeight: 1.7 }}>大模型只出现在这三层；推荐、路径、桩状态这些实时环节，刻意不用。</Text>
                </Box>
                <Box style={{ border: '1px solid rgba(255,255,255,0.45)', borderRadius: '999px', padding: '8px 16px', alignSelf: 'flex-start' }}>
                    <Text style={{ fontSize: 13, fontWeight: 600, color: '#FFFFFF' }}>实时决策：确定性算法</Text>
                </Box>
            </Box>

            {/* 右：三层用点 */}
            <Box style={{ flex: 1, flexDirection: 'column', gap: '12px' }}>
                <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E8EF', borderRadius: '12px', padding: '14px 18px', flexDirection: 'row', alignItems: 'center', gap: '16px' }}>
                    <Box style={{ width: '56px', height: '30px', borderRadius: '8px', background: '#F5A623', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13, fontWeight: 600, color: '#FFFFFF' }}>入口</Text>
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'column', gap: '4px' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#16181D' }}>LLM 意图解析</Text>
                        <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.5 }}>「找个离海底捞近、能充电、婴儿车能走的车位」→ 结构化约束 → 交推荐引擎执行</Text>
                    </Box>
                </Box>

                <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E8EF', borderRadius: '12px', padding: '14px 18px', flexDirection: 'row', alignItems: 'center', gap: '16px' }}>
                    <Box style={{ width: '56px', height: '30px', borderRadius: '8px', background: '#F5A623', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13, fontWeight: 600, color: '#FFFFFF' }}>兜底</Text>
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'column', gap: '4px' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#16181D' }}>多模态 OCR</Text>
                        <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.5 }}>拍停车小票 / 订单照片 → 结构化入库 → 作为车位绑定的兜底通道</Text>
                    </Box>
                </Box>

                <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E8EF', borderRadius: '12px', padding: '14px 18px', flexDirection: 'row', alignItems: 'center', gap: '16px' }}>
                    <Box style={{ width: '56px', height: '30px', borderRadius: '8px', background: '#F5A623', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13, fontWeight: 600, color: '#FFFFFF' }}>输出</Text>
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'column', gap: '4px' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#16181D' }}>生成式解释</Text>
                        <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.5 }}>把推荐结果翻译成「为什么是这个车位」——推荐可解释，用户才敢用</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* 圆场口径通栏 */}
        <Box style={{ height: '124px', flexDirection: 'row', background: 'rgba(245,166,35,0.10)', borderRadius: '12px' }}>
            <Box style={{ width: '4px', height: '100%', background: '#F5A623', borderRadius: '12px 0 0 12px' }} />
            <Box style={{ flex: 1, padding: '14px 22px', flexDirection: 'column', justifyContent: 'center', gap: '6px' }}>
                <Text style={{ fontSize: 15, color: '#16181D', lineHeight: 1.55 }}>停车链路对时延、可解释、可离线有硬要求，因此实时决策使用确定性算法；大模型只在「理解人话、解释理由、兜底录入」三层发挥作用。</Text>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#16181D' }}>主动把 AI 约束在合适的层，是工程成熟度的体现，不是能力不足。</Text>
            </Box>
        </Box>
    </Box>

    {/* C 页脚条 */}
    <Box style={{ height: '40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
            <FAIcon name='car' style={{ fill: '#2456E6', width: '18px', height: '18px' }} />
            <Text style={{ fontSize: 13, color: '#5C6470' }}>车记得 · 完美金鹰假日商圈 AI 大赛</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#5C6470' }}><span style={{ fontWeight: 'bold', color: '#2456E6' }}>05</span> / 12</Text>
    </Box>
</Slide>
