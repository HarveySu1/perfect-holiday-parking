<Slide style={{ width: '1280px', height: '720px', padding: '20px 64px', flexDirection: 'column', background: '#FFFFFF' }}>
    {/* A 标题块 */}
    <Box style={{ height: '100px', flexDirection: 'column', justifyContent: 'center', gap: '6px' }}>
        <Text style={{ fontSize: 13, fontWeight: 600, color: '#2456E6', letterSpacing: 2 }}>合规 · 走得远吗</Text>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#16181D', lineHeight: 1.25 }}>架构上就绕开了车牌敏感信息</Text>
    </Box>

    {/* B 内容区 */}
    <Box style={{ height: '540px', flexDirection: 'column', gap: '12px' }}>
        {/* 引导句 */}
        <Text style={{ fontSize: 19, color: '#5C6470', lineHeight: 1.5 }}>三条红线逐条给出落地处理，不做「原则上支持」式的空承诺。</Text>

        {/* 非对称双栏 60:40 */}
        <Box style={{ flexDirection: 'row', gap: '24px', flex: 1 }}>
            {/* 左 60%：三红线落地表（纵向三行） */}
            <Box style={{ width: '688px', flexDirection: 'column', gap: '10px' }}>
                {/* 行 1 */}
                <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'stretch', background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '10px', overflow: 'hidden' }}>
                    <Box style={{ width: '3px', background: '#F5A623' }} />
                    <Box style={{ flex: 1, flexDirection: 'column', padding: '12px 16px', gap: '4px' }}>
                        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
                            <Text style={{ fontSize: 12, fontWeight: 600, color: '#F5A623', letterSpacing: 1 }}>红线 1</Text>
                            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#16181D' }}>微信订阅消息有调用限制</Text>
                        </Box>
                        <Text style={{ fontSize: 14, color: '#16181D', lineHeight: 1.5 }}>不做自动定时推送；停车时用户主动授权一次下发凭证，返程前由用户主动生成路线。</Text>
                    </Box>
                </Box>

                {/* 行 2 */}
                <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'stretch', background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '10px', overflow: 'hidden' }}>
                    <Box style={{ width: '3px', background: '#F5A623' }} />
                    <Box style={{ flex: 1, flexDirection: 'column', padding: '12px 16px', gap: '4px' }}>
                        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
                            <Text style={{ fontSize: 12, fontWeight: 600, color: '#F5A623', letterSpacing: 1 }}>红线 2</Text>
                            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#16181D' }}>车牌属敏感个人信息</Text>
                        </Box>
                        <Text style={{ fontSize: 14, color: '#16181D', lineHeight: 1.5 }}>主链路以会员码 + 车位码绑定；功能①完整发生在停车前，整条链路不需要车牌。</Text>
                    </Box>
                </Box>

                {/* 行 3 */}
                <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'stretch', background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '10px', overflow: 'hidden' }}>
                    <Box style={{ width: '3px', background: '#F5A623' }} />
                    <Box style={{ flex: 1, flexDirection: 'column', padding: '12px 16px', gap: '4px' }}>
                        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
                            <Text style={{ fontSize: 12, fontWeight: 600, color: '#F5A623', letterSpacing: 1 }}>红线 3</Text>
                            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#16181D' }}>地下车库网络不稳定</Text>
                        </Box>
                        <Text style={{ fontSize: 14, color: '#16181D', lineHeight: 1.5 }}>数据随小程序包内置、路径本地计算；空桩状态读本地缓存，并显式标注数据时效。</Text>
                    </Box>
                </Box>
            </Box>

            {/* 右 40%：架构优势强调卡（主蓝） */}
            <Box style={{ flex: 1, flexDirection: 'column', background: '#2456E6', borderRadius: '12px', padding: '24px', gap: '14px' }}>
                <Box style={{ background: 'rgba(245,166,35,0.12)', border: '1px solid #F5A623', borderRadius: '4px', padding: '3px 8px', flexDirection: 'row', alignSelf: 'flex-start' }}>
                    <Text style={{ fontSize: 12, fontWeight: 600, color: '#F5A623' }}>架构优势</Text>
                </Box>
                <Text style={{ fontSize: 56, fontWeight: 'bold', fontFamily: '"Inter", "Noto Sans SC", sans-serif', color: '#FFFFFF', lineHeight: 1.1 }}>不需要车牌</Text>
                <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.85)', lineHeight: 1.6 }}>最核心的创新功能——目的地选车位，完整发生在停车之前，从架构上绕开了车牌这一敏感信息。</Text>
                <Box style={{ marginTop: 'auto', background: 'rgba(255,255,255,0.10)', borderLeft: '3px solid #F5A623', borderRadius: '4px', padding: '10px 12px' }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF', lineHeight: 1.5 }}>这不是回避合规，是从架构上绕开了它。</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    {/* C 页脚条 */}
    <Box style={{ height: '40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
            <FAIcon name='car' style={{ fill: '#2456E6', width: '18px', height: '18px' }} />
            <Text style={{ fontSize: 13, color: '#5C6470' }}>车记得 · 完美金鹰假日商圈 AI 大赛</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#5C6470' }}><span style={{ fontWeight: 'bold', color: '#2456E6' }}>08</span> / 12</Text>
    </Box>
</Slide>
