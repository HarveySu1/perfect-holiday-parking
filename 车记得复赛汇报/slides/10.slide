<Slide style={{ width: '1280px', height: '720px', padding: '20px 64px', flexDirection: 'column', background: '#FFFFFF' }}>
    {/* A 标题块 */}
    <Box style={{ height: '100px', flexDirection: 'column', justifyContent: 'center', gap: '6px' }}>
        <Text style={{ fontSize: 13, fontWeight: 600, color: '#2456E6', letterSpacing: 2 }}>备份 B1 · 被问「有没有人做过」时翻此页</Text>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#16181D', lineHeight: 1.25 }}>竞品能力矩阵详表</Text>
    </Box>

    {/* B 内容区 */}
    <Box style={{ height: '540px', flexDirection: 'row', gap: '22px' }}>
        {/* 左 30%：三条结论 */}
        <Box style={{ width: '330px', flexDirection: 'column', gap: '10px' }}>
            <Box style={{ flex: 1, background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '10px', padding: '12px 14px', flexDirection: 'column', gap: '4px', justifyContent: 'center' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '6px' }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', fontFamily: '"Inter", "Noto Sans SC", sans-serif', color: '#2456E6' }}>01</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#16181D' }}>「记住」是行业天花板</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.45 }}>手机厂商止于记车位，管理平台有真值不做推荐</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '10px', padding: '12px 14px', flexDirection: 'column', gap: '4px', justifyContent: 'center' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '6px' }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', fontFamily: '"Inter", "Noto Sans SC", sans-serif', color: '#2456E6' }}>02</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#16181D' }}>无人覆盖停车前决策</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.45 }}>充电平台只管桩不管路；四类玩家均无「选车位」</Text>
            </Box>
            <Box style={{ flex: 1, background: 'rgba(15,169,88,0.10)', border: '1px solid rgba(15,169,88,0.35)', borderRadius: '10px', padding: '12px 14px', flexDirection: 'column', gap: '4px', justifyContent: 'center' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '6px' }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', fontFamily: '"Inter", "Noto Sans SC", sans-serif', color: '#0FA958' }}>03</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#16181D' }}>差距即空间</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.45 }}>主办方数据最全却缺决策层；车记得三项全 ✔ 且复用真值</Text>
            </Box>
        </Box>

        {/* 右 70%：矩阵表 + 判断条 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: '12px' }}>
            <Box style={{ height: '440px' }}>
                <Table
                    style={{ width: '100%', height: '100%' }}
                    defaultTextStyle={{ fontSize: 15, textAlign: 'center', color: '#16181D' }}
                    defaultCellStyle={{
                        border: {
                            left: { width: 1, color: '#E5E8EF' },
                            right: { width: 1, color: '#E5E8EF' },
                            top: { width: 1, color: '#E5E8EF' },
                            bottom: { width: 1, color: '#E5E8EF' },
                        },
                    }}
                    cells={[
                        [
                            { text: '玩家 ＼ 能力', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#2456E6' } } },
                            { text: '跨场数据', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#2456E6' } } },
                            { text: '车位真值', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#2456E6' } } },
                            { text: '目的地选车位', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#2456E6' } } },
                            { text: '垂直交通决策', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#2456E6' } } },
                            { text: '空桩导航', textStyle: { bold: true, color: '#FFFFFF', fontSize: 14 }, cellStyle: { background: { color: '#2456E6' } } },
                        ],
                        [
                            { text: 'ETCP 等管理平台', textStyle: { bold: true, fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '—', '✔', '✘', '✘', '✘',
                        ],
                        [
                            { text: '手机厂商地图', textStyle: { bold: true, fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '✔', '✘', '✘', '✘', '✘',
                        ],
                        [
                            { text: '充电平台', textStyle: { bold: true, fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '✘', '✘', '✘', '✘', '✔',
                        ],
                        [
                            { text: '主办方现有系统', textStyle: { bold: true, fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '✔', '✔', '✘', '✘', '✘',
                        ],
                        [
                            { text: '车记得 · 决策层', textStyle: { bold: true, fontSize: 14, color: '#0FA958' }, cellStyle: { background: { color: 'rgba(15,169,88,0.10)' } } },
                            { text: '△ 规划', textStyle: { color: '#F5A623', fontSize: 13 }, cellStyle: { background: { color: 'rgba(15,169,88,0.10)' } } },
                            { text: '✔ 复用', textStyle: { color: '#0FA958', bold: true }, cellStyle: { background: { color: 'rgba(15,169,88,0.10)' } } },
                            { text: '✔', textStyle: { color: '#0FA958', bold: true, fontSize: 17 }, cellStyle: { background: { color: 'rgba(15,169,88,0.10)' } } },
                            { text: '✔', textStyle: { color: '#0FA958', bold: true, fontSize: 17 }, cellStyle: { background: { color: 'rgba(15,169,88,0.10)' } } },
                            { text: '✔', textStyle: { color: '#0FA958', bold: true, fontSize: 17 }, cellStyle: { background: { color: 'rgba(15,169,88,0.10)' } } },
                        ],
                    ]}
                />
            </Box>
            {/* 判断条 */}
            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: '10px', background: '#F5F7FB', border: '1px solid #E5E8EF', borderLeft: '3px solid #2456E6', borderRadius: '8px', padding: '0 16px' }}>
                <Text style={{ fontSize: 12, fontWeight: 600, color: '#5C6470', letterSpacing: 1 }}>图例</Text>
                <Text style={{ fontSize: 13, color: '#16181D' }}>✔ 已有能力　✘ 不具备　△ 三期规划　— 不适用</Text>
                <Text style={{ marginLeft: 'auto', fontSize: 15, fontWeight: 'bold', color: '#16181D' }}>「记住」是天花板，不是终点——差距即空间。</Text>
            </Box>
        </Box>
    </Box>

    {/* C 页脚条 */}
    <Box style={{ height: '40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
            <FAIcon name='car' style={{ fill: '#2456E6', width: '18px', height: '18px' }} />
            <Text style={{ fontSize: 13, color: '#5C6470' }}>车记得 · 完美金鹰假日商圈 AI 大赛</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#5C6470' }}><span style={{ fontWeight: 'bold', color: '#2456E6' }}>10</span> / 12</Text>
    </Box>
</Slide>
