<Slide style={{ width: '1280px', height: '720px', padding: '20px 64px', flexDirection: 'column', background: '#FFFFFF' }}>
    {/* A 标题块 */}
    <Box style={{ height: '100px', flexDirection: 'column', justifyContent: 'center', gap: '6px' }}>
        <Text style={{ fontSize: 13, fontWeight: 600, color: '#2456E6', letterSpacing: 2 }}>备份 B2 · 被问技术深度时翻此页</Text>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#16181D', lineHeight: 1.25 }}>技术架构与降级链</Text>
    </Box>

    {/* B 内容区 */}
    <Box style={{ height: '540px', flexDirection: 'column', gap: '12px' }}>
        {/* 引导句 */}
        <Text style={{ fontSize: 19, color: '#5C6470', lineHeight: 1.5 }}>决策服务层以云函数挂载在主办方小程序上，对已有系统只读、复用，不做任何改动。</Text>

        {/* 架构图（三层 + 边界标注） */}
        <Box style={{ height: '248px', flexDirection: 'column', gap: '5px' }}>
            {/* 顶层：主办方已有小程序 */}
            <Box style={{ height: '46px', flexDirection: 'row', alignItems: 'center', background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '8px', padding: '0 16px', gap: '10px' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#16181D' }}>主办方已有小程序（用户侧入口）</Text>
                <Box style={{ marginLeft: 'auto', background: 'rgba(245,166,35,0.12)', border: '1px solid #F5A623', borderRadius: '4px', padding: '2px 8px' }}>
                    <Text style={{ fontSize: 12, fontWeight: 600, color: '#F5A623' }}>只读</Text>
                </Box>
            </Box>
            {/* 连接标注 1 */}
            <Box style={{ height: '22px', flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: '8px' }}>
                <FAIcon name='exchange' style={{ fill: '#5C6470', width: '13px', height: '13px' }} />
                <Text style={{ fontSize: 12, color: '#5C6470' }}>只读接口：车位真值 / POI / 实时状态——不写回、不改动</Text>
            </Box>
            {/* 中层：决策服务层 */}
            <Box style={{ height: '92px', flexDirection: 'column', background: '#2456E6', borderRadius: '8px', padding: '10px 16px', gap: '8px' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '10px' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>车记得 · 决策服务层</Text>
                    <Text style={{ fontSize: 12, color: 'rgba(255,255,255,0.75)' }}>云函数挂载 · 零硬件 · 零系统改造</Text>
                    <Box style={{ marginLeft: 'auto', background: 'rgba(255,255,255,0.15)', borderRadius: '4px', padding: '2px 8px' }}>
                        <Text style={{ fontSize: 12, fontWeight: 600, color: '#FFFFFF' }}>本次唯一新建</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: '10px', flex: 1 }}>
                    <Box style={{ flex: 1, background: 'rgba(255,255,255,0.12)', borderRadius: '6px', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 14, fontWeight: 600, color: '#FFFFFF' }}>推荐引擎</Text>
                    </Box>
                    <Box style={{ flex: 1, background: 'rgba(255,255,255,0.12)', borderRadius: '6px', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 14, fontWeight: 600, color: '#FFFFFF' }}>竖向路径图 · 多层 A*</Text>
                    </Box>
                    <Box style={{ flex: 1, background: 'rgba(255,255,255,0.12)', borderRadius: '6px', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 14, fontWeight: 600, color: '#FFFFFF' }}>状态聚合器</Text>
                    </Box>
                </Box>
            </Box>
            {/* 连接标注 2 */}
            <Box style={{ height: '22px', flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: '8px' }}>
                <FAIcon name='exchange' style={{ fill: '#5C6470', width: '13px', height: '13px' }} />
                <Text style={{ fontSize: 12, color: '#5C6470' }}>复用接口：地图 / 导航 / 车位真值 / 电梯厅标注——原样调用</Text>
            </Box>
            {/* 底层：已有能力 */}
            <Box style={{ height: '46px', flexDirection: 'row', alignItems: 'center', background: 'rgba(15,169,88,0.10)', border: '1px solid rgba(15,169,88,0.35)', borderRadius: '8px', padding: '0 16px', gap: '10px' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#16181D' }}>主办方已有：2D/3D 地图 · 导航引擎 · 车位真值 · 电梯厅标注</Text>
                <Box style={{ marginLeft: 'auto', background: 'rgba(15,169,88,0.10)', border: '1px solid rgba(15,169,88,0.35)', borderRadius: '4px', padding: '2px 8px' }}>
                    <Text style={{ fontSize: 12, fontWeight: 600, color: '#0FA958' }}>复用不改动</Text>
                </Box>
            </Box>
        </Box>

        {/* 新建主数据条 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
            <Box style={{ width: '3px', height: '14px', background: '#2456E6', borderRadius: '2px' }} />
            <Text style={{ fontSize: 13, color: '#5C6470', lineHeight: 1.4 }}>新建主数据仅三张：POI / 竖向交通 / 车位-桩绑定——静态数据，可一次性内置小程序包，兼顾弱网。</Text>
        </Box>

        {/* 三降级链卡 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: '12px' }}>
            {/* 卡 ① */}
            <Box style={{ flex: 1, flexDirection: 'column', background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '10px', padding: '12px 14px', gap: '8px' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
                    <Text style={{ fontSize: 12, fontWeight: 600, color: '#2456E6' }}>功能 ①</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#16181D' }}>目的地选车位</Text>
                    <Text style={{ marginLeft: 'auto', fontSize: 11, color: '#5C6470', letterSpacing: 1 }}>降级链</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: 13, color: '#16181D', lineHeight: 1.45 }}>同层近区 → 半径 +1 区 → 其他层 → 跨场 → 全满提示</Text>
                </Box>
                <Box style={{ marginTop: 'auto', background: '#FFFFFF', border: '1px solid #E5E8EF', borderRadius: '6px', padding: '6px 10px' }}>
                    <Text style={{ fontSize: 12, color: '#5C6470', lineHeight: 1.4 }}>任一步不可用即顺降，永不返回空结果</Text>
                </Box>
            </Box>
            {/* 卡 ② */}
            <Box style={{ flex: 1, flexDirection: 'column', background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '10px', padding: '12px 14px', gap: '8px' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
                    <Text style={{ fontSize: 12, fontWeight: 600, color: '#2456E6' }}>功能 ②</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#16181D' }}>电梯厅选梯</Text>
                    <Text style={{ marginLeft: 'auto', fontSize: 11, color: '#5C6470', letterSpacing: 1 }}>降级链</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: 13, color: '#16181D', lineHeight: 1.45 }}>多层竖向图建图来不及 → 分段编排当天可用</Text>
                </Box>
                <Box style={{ marginTop: 'auto', background: '#FFFFFF', border: '1px solid #E5E8EF', borderRadius: '6px', padding: '6px 10px' }}>
                    <Text style={{ fontSize: 12, color: '#5C6470', lineHeight: 1.4 }}>先按楼层给建议，多层图就绪后自动切换</Text>
                </Box>
            </Box>
            {/* 卡 ③ */}
            <Box style={{ flex: 1, flexDirection: 'column', background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '10px', padding: '12px 14px', gap: '8px' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
                    <Text style={{ fontSize: 12, fontWeight: 600, color: '#2456E6' }}>功能 ③</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#16181D' }}>充电桩导航</Text>
                    <Text style={{ marginLeft: 'auto', fontSize: 11, color: '#5C6470', letterSpacing: 1 }}>降级链</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: '4px' }}>
                    <Text style={{ fontSize: 13, color: '#16181D', lineHeight: 1.45 }}>接口缺 → 三级来源 + 置信度衰减 exp(-τ/15min)</Text>
                </Box>
                <Box style={{ marginTop: 'auto', background: '#FFFFFF', border: '1px solid #E5E8EF', borderRadius: '6px', padding: '6px 10px' }}>
                    <Text style={{ fontSize: 12, color: '#5C6470', lineHeight: 1.4 }}>状态不明时显式标注时效，不伪造「空闲」</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    {/* C 页脚条 */}
    <Box style={{ height: '40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
            <FAIcon name='car' style={{ fill: '#2456E6', width: '18px', height: '18px' }} />
            <Text style={{ fontSize: 13, color: '#5C6470' }}>车记得 · 完美金鹰假日商圈 AI 大赛</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#5C6470' }}><span style={{ fontWeight: 'bold', color: '#2456E6' }}>11</span> / 12</Text>
    </Box>
</Slide>
