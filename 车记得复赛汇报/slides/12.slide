<Slide style={{ width: '1280px', height: '720px', padding: '20px 64px', flexDirection: 'column', background: '#FFFFFF' }}>
    {/* A 标题块 */}
    <Box style={{ height: '100px', flexDirection: 'column', justifyContent: 'center', gap: '6px' }}>
        <Text style={{ fontSize: 13, fontWeight: 600, color: '#2456E6', letterSpacing: 2 }}>备份 B3 · 复赛提交「项目演示视频」用</Text>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#16181D', lineHeight: 1.25 }}>演示视频脚本（30–60 秒）</Text>
    </Box>

    {/* B 内容区 */}
    <Box style={{ height: '540px', flexDirection: 'row', gap: '22px' }}>
        {/* 左 28%：锚点 + 形式 + 判断 + 诚实标注 */}
        <Box style={{ width: '320px', flexDirection: 'column', gap: '12px' }}>
            <Box style={{ flexDirection: 'column', gap: '2px' }}>
                <Text style={{ fontSize: 48, fontWeight: 'bold', fontFamily: '"Inter", "Noto Sans SC", sans-serif', color: '#2456E6', lineHeight: 1 }}>30–60s</Text>
                <Text style={{ fontSize: 15, color: '#5C6470', lineHeight: 1.5 }}>demo 录屏 + 字幕，无真人出镜；评委看页，点开即演</Text>
            </Box>

            {/* 判断条 */}
            <Box style={{ background: '#F5F7FB', border: '1px solid #E5E8EF', borderLeft: '3px solid #2456E6', borderRadius: '8px', padding: '10px 12px' }}>
                <Text style={{ fontSize: 13, color: '#16181D', lineHeight: 1.5 }}>视频与 PPT 互为印证：PPT 讲清判断，视频证明当场能演。</Text>
            </Box>

            {/* 诚实标注（与 P6 同口径） */}
            <Box style={{ marginTop: 'auto', background: '#F5F7FB', border: '1px solid #E5E8EF', borderRadius: '8px', padding: '10px 12px', gap: '6px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '6px' }}>
                    <Box style={{ width: '3px', height: '13px', background: '#F5A623', borderRadius: '2px' }} />
                    <Text style={{ fontSize: 12, fontWeight: 600, color: '#F5A623', letterSpacing: 1 }}>诚实标注</Text>
                </Box>
                <Text style={{ fontSize: 12, color: '#5C6470', lineHeight: 1.5 }}>与 P6 同口径：当前 AI 解析为关键词模拟，真实链路接入多模态大模型 API；演示车位、桩数为模拟数据，非实测。</Text>
            </Box>
        </Box>

        {/* 右 72%：六+1 段时间码表 */}
        <Box style={{ flex: 1, flexDirection: 'column' }}>
            <Box style={{ flex: 1 }}>
                <Table
                    style={{ width: '100%', height: '100%' }}
                    defaultTextStyle={{ fontSize: 14, textAlign: 'left', color: '#16181D' }}
                    defaultCellStyle={{
                        border: {
                            left: { width: 1, color: '#E5E8EF' },
                            right: { width: 1, color: '#E5E8EF' },
                            top: { width: 1, color: '#E5E8EF' },
                            bottom: { width: 1, color: '#E5E8EF' },
                        },
                    }}
                    cells={[
                        [
                            { text: '时间码', textStyle: { bold: true, color: '#FFFFFF', fontSize: 13 }, cellStyle: { background: { color: '#2456E6' } } },
                            { text: '画面', textStyle: { bold: true, color: '#FFFFFF', fontSize: 13 }, cellStyle: { background: { color: '#2456E6' } } },
                            { text: '字幕 / 台词', textStyle: { bold: true, color: '#FFFFFF', fontSize: 13 }, cellStyle: { background: { color: '#2456E6' } } },
                        ],
                        [
                            { text: '0–5s', textStyle: { bold: true, color: '#2456E6', fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '首页 AI 入口卡入镜',
                            { text: '「系统已经很完整，但它不替你做选择」', textStyle: { color: '#16181D' } },
                        ],
                        [
                            { text: '5–15s', textStyle: { bold: true, color: '#2456E6', fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '进入目的地选择页，AI 横幅出现',
                            { text: '「补一层决策服务」', textStyle: { color: '#16181D' } },
                        ],
                        [
                            { text: '15–25s', textStyle: { bold: true, color: '#2456E6', fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '输入「去海底捞，要充电」，点示例让 AI 解析',
                            { text: '「和 AI 说一句就行」', textStyle: { color: '#16181D' } },
                        ],
                        [
                            { text: '25–35s', textStyle: { bold: true, color: '#2456E6', fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '三步流水线动画 + 约束卡',
                            { text: '「意图解析 → 约束结构化 → 推荐引擎」', textStyle: { color: '#16181D' } },
                        ],
                        [
                            { text: '35–45s', textStyle: { bold: true, color: '#2456E6', fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '推荐卡：车位编号 + 推荐理由 + AI 约束已应用',
                            { text: '「为什么是这个车位」', textStyle: { color: '#16181D' } },
                        ],
                        [
                            { text: '45–55s', textStyle: { bold: true, color: '#2456E6', fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '点「导航到此车位」，复用已有模拟导航',
                            { text: '「零硬件、零改造」', textStyle: { color: '#16181D' } },
                        ],
                        [
                            { text: '55–60s', textStyle: { bold: true, color: '#2456E6', fontSize: 14 }, cellStyle: { background: { color: '#F5F7FB' } } },
                            '黑场 + slogan 落版',
                            { text: '「让已有的能力真正被用起来，而不是再盖一栋楼」', textStyle: { color: '#F5A623', bold: true } },
                        ],
                    ]}
                />
            </Box>
        </Box>
    </Box>

    {/* C 页脚条 */}
    <Box style={{ height: '40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: '8px' }}>
            <FAIcon name='car' style={{ fill: '#2456E6', width: '18px', height: '18px' }} />
            <Text style={{ fontSize: 13, color: '#5C6470' }}>车记得 · 完美金鹰假日商圈 AI 大赛</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#5C6470' }}><span style={{ fontWeight: 'bold', color: '#2456E6' }}>12</span> / 12</Text>
    </Box>
</Slide>
